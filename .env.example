# Copy this file to .env and review every value before deployment.
APP_ORIGIN=http://localhost:3000
PORT=3000
HOST=127.0.0.1
DATABASE_DRIVER=postgres
POSTGRES_DB=acm_classroom
POSTGRES_USER=acm_classroom
# Use: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql://acm_classroom:CHANGE_ME_GENERATE_A_RANDOM_HEX_PASSWORD@127.0.0.1:5432/acm_classroom?sslmode=disable
# Optional isolated database used only by `npm run test:postgres`; create this database separately and never use production DB here.
TEST_DATABASE_URL=postgresql://acm_classroom:CHANGE_ME_GENERATE_A_RANDOM_HEX_PASSWORD@127.0.0.1:5432/acm_classroom_test?sslmode=disable
# Pool settings for the async node-postgres driver.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=8000
# PostgreSQL client tools are needed only for verified backup/restore commands.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
SESSION_HOURS=12
DOCKER_IMAGE=python:3.13-alpine
MAX_CONCURRENT_JUDGES=3
NODE_ENV=production

# Docker is the only supported judging backend.
DOCKER_CPP_IMAGE=acm-cpp-runner:17

# Optional: create a bot with @botfather in Bale and put its token here.
# The bot starts automatically with `npm start`.
BALE_BOT_TOKEN=
