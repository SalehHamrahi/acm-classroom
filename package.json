{
  "name": "acm-classroom",
  "version": "2.13.0",
  "private": true,
  "description": "Private ACM platform for assignments, programming contests and Docker-only Python/C++ judging",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "node server/index.js",
    "setup:admin": "node scripts/setup-admin.js",
    "test": "node --test",
    "copy:monaco": "node scripts/copy-monaco.js",
    "predev": "npm run copy:monaco",
    "prebuild": "npm run copy:monaco",
    "docker:build-cpp": "docker build -t acm-cpp-runner:17 -f docker/cpp-runner/Dockerfile .",
    "backup:db": "node scripts/create-backup.js",
    "restore:db": "node scripts/restore-backup.js",
    "db:check": "node scripts/check-db.js",
    "test:postgres": "node scripts/run-postgres-api-tests.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "browserslist": "4.29.3"
  }
}
