[Unit]
Description=Daily ACM Classroom PostgreSQL backup
After=acm-classroom.service

[Service]
Type=oneshot
User=acmclassroom
Group=acmclassroom
WorkingDirectory=/opt/acm-classroom
Environment=APP_DIR=/opt/acm-classroom
EnvironmentFile=/opt/acm-classroom/.env
ExecStart=/usr/local/sbin/acm-classroom-backup
